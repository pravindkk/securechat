# ===========================================
# Local Development Configuration
# ===========================================
# Copy to .env.local: cp .env.example .env.local
# Then run: docker-compose up -d && npm run dev

# Database (works with docker-compose.yml)
DATABASE_URL="postgresql://chatapp:chatapp@localhost:5432/chatapp"
MONGODB_URI="mongodb://localhost:27017/chatapp"

# JWT Secrets (for local dev only - generate new ones for production with: openssl rand -hex 32)
JWT_SECRET="dev_jwt_secret_do_not_use_in_production_1234567890abcdef"
JWT_REFRESH_SECRET="dev_refresh_secret_do_not_use_in_production_1234567890"

# Master encryption key (for local dev only)
MASTER_ENCRYPTION_KEY="0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef"
