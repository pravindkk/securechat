# Database
DATABASE_URL="postgresql://user:password@localhost:5432/securechat"
MONGODB_URI="mongodb://localhost:27017/securechat"

# JWT Secrets (generate with: openssl rand -hex 32)
JWT_SECRET="your-jwt-secret-here"
JWT_REFRESH_SECRET="your-refresh-secret-here"

# Master encryption key for server-side key storage (generate with: openssl rand -hex 32)
MASTER_ENCRYPTION_KEY="your-64-char-hex-master-key-here"

# Pusher (for real-time communication)
PUSHER_APP_ID="your-pusher-app-id"
PUSHER_SECRET="your-pusher-secret"
NEXT_PUBLIC_PUSHER_KEY="your-pusher-key"
NEXT_PUBLIC_PUSHER_CLUSTER="us2"

# Optional: Analytics, etc.
# NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"
