# ===========================================
# SECURE CHAT TLS - BACKEND ENVIRONMENT VARIABLES
# ===========================================
# End-to-end encrypted messaging with OTP-only authentication
# TLS 1.3 style encryption with multi-device support
#
# Copy this file to .env before starting development:
#   cp .env.example .env

NODE_ENV=development
PORT=5001

# ===========================================
# DATABASE CONFIGURATION
# ===========================================

# PostgreSQL connection string (Prisma)
# Used for: users, rooms, sessions, encryption keys
DATABASE_URL=postgresql://chatapp:chatapp@localhost:5432/chatapp?schema=public

# MongoDB connection string
# Used for: encrypted messages
MONGODB_URI=mongodb://localhost:27017/chatapp

# Redis connection string
# Used for: sessions, Socket.IO adapter, online status
REDIS_URL=redis://localhost:6379

# ===========================================
# MINIO (S3-COMPATIBLE STORAGE)
# ===========================================
# Used for: image/file uploads

MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=chatapp
MINIO_USE_SSL=false

# ===========================================
# JWT AUTHENTICATION
# ===========================================
# IMPORTANT: Generate strong random secrets for production!
# Generate using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# Access token secret (min 32 characters)
JWT_SECRET=dev_jwt_secret_key_change_in_production_32chars

# Refresh token secret (min 32 characters, must differ from JWT_SECRET)
JWT_REFRESH_SECRET=dev_refresh_secret_change_in_production_32

# ===========================================
# CORS CONFIGURATION
# ===========================================
# Frontend URL(s) allowed to access the API
# For multiple origins, comma-separate: http://localhost:3000,http://localhost:3001

CORS_ORIGIN=http://localhost:3001

# ===========================================
# OTP CONFIGURATION
# ===========================================

OTP_EXPIRY_MINUTES=10
OTP_LENGTH=6

# ===========================================
# ENCRYPTION CONFIGURATION
# ===========================================
# Master encryption key for server-side private key recovery
# MUST be exactly 64 hex characters (32 bytes)
# Generate using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 
# WARNING: Changing this key will invalidate all existing user private keys!

MASTER_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
